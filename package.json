{
  "name": "@xuwenhao/agent-shell-guard",
  "version": "0.1.0",
  "description": "AST-based shell safety guard for Claude Code, Codex, and Kimi Code",
  "type": "module",
  "bin": {
    "agent-shell-guard": "./src/cli.mjs"
  },
